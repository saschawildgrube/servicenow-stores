    <sys_script_include action="INSERT_OR_UPDATE">
        <access>public</access>
        <active>true</active>
        <api_name>x_snc_stores.GetStores</api_name>
        <caller_access/>
        <client_callable>false</client_callable>
        <description>Returns an array of objects representing active Stores stored in the x_snc_stores_store table.</description>
        <mobile_callable>false</mobile_callable>
        <name>GetStores</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[function GetStores()
{
	var aStores = [];

	var grStores = new GlideRecord('x_snc_stores_store');
	grStores.addQuery('active','=',true);
	grStores.query();
	while (grStores.next())
	{
		var store = GetStore(grStores);
		aStores.push(store);
	}
	return aStores;
}]]></script>
