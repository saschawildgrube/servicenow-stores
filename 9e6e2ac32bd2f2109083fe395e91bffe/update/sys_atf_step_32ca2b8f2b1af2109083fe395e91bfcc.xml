        <value>(function(outputs, steps, stepResult, assertEqual)&#13;
{&#13;
	var test = new x_snc_devtools.TestAPI(outputs, steps, stepResult, assertEqual);&#13;
	&#13;
	test.SetResult(true);&#13;
	&#13;
	test.TestCase_RestApiOperation(&#13;
		'Stores API',&#13;
		'Get Stores',&#13;
		null,&#13;
		null,&#13;
		'User Not Authenticated');&#13;
	&#13;
	&#13;
	var testdata = new x_snc_devtools.TestDataAPI('Stores');&#13;
	var strPassword = x_snc_devtools.GetRandomNumericToken(30);&#13;
	&#13;
	var strUserNoRolesSysId = testdata.CreateUser('No Roles',[],false,'',strPassword);&#13;
	var grUserNoRoles = x_snc_devtools.GetUserRecord(strUserNoRolesSysId);&#13;
	var oBasicAuth = {&#13;
		username: x_snc_devtools.GetStringValue(grUserNoRoles.user_name),&#13;
		password: strPassword&#13;
	};&#13;
	&#13;
	test.TestCase_RestApiOperation(&#13;
		'Stores API',&#13;
		'Get Stores',&#13;
		oBasicAuth,&#13;
		null,&#13;
		'User Not Authorized');&#13;
&#13;
	var strUserApiSysId = testdata.CreateUser('Stores API',['x_snc_stores.api'],false,'',strPassword);&#13;
	var grUserAPI = x_snc_devtools.GetUserRecord(strUserApiSysId);&#13;
	var oBasicAuth = {&#13;
		username: x_snc_devtools.GetStringValue(grUserAPI.user_name),&#13;
		password: strPassword&#13;
	};&#13;
	&#13;
	test.TestCase_RestApiOperation(&#13;
		'Stores API',&#13;
		'Get Stores',&#13;
		oBasicAuth,&#13;
		null,&#13;
		'SUCCESS');		&#13;
	&#13;
	&#13;
	&#13;
	return test.GetResult();&#13;
	&#13;
})(outputs, steps, stepResult, assertEqual);</value>
