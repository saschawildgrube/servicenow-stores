        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	var strName = '';

	if (current.type == 'region')
	{
		var grCountry = x_snc_devtools.GetCountryRecord(current.country);
		if (grCountry != false)
		{
			strName += grCountry.getDisplayValue();
		}
		var grSubdivision = x_snc_devtools.GetRecord('x_snc_geodata_country_subdivision',current.subdivision);
		if (grSubdivision != false)
		{
			if (strName != '')
			{
				strName += ' - ';
			}
			strName += grSubdivision.getDisplayValue();
		}

	}

	if (current.type == 'store')
	{
		var grStore = x_snc_devtools.GetRecord('x_snc_stores_store',current.store);
		if (grStore != false)
		{
			strName += grStore.getDisplayValue();
		}
	}	


	current.name = strName;

})(current, previous);]]></script>
